# syntax=docker/dockerfile:1.7

# Stage 1: Clone the repository
FROM alpine/git:v2.49.0 AS clone
ARG BATMAN_REF=master
RUN git clone --branch ${BATMAN_REF} --single-branch --depth=1 https://github.com/codejie/Batman.git /batman

# Stage 2: Build the frontend application
FROM node:22.16.0-alpine3.22 AS builder
ARG API_URL="http://localhost:8000"
ENV PNPM_STORE_DIR=/pnpm/store

WORKDIR /app

# Install pnpm and dependencies before copying source so dependency layers cache better.
RUN npm install -g pnpm@9.15.9
COPY --from=clone /batman/signal/package.json ./
RUN --mount=type=cache,id=batman-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir ${PNPM_STORE_DIR} \
    && pnpm config set registry https://registry.npmmirror.com \
    && pnpm config set fetch-retries 5 \
    && pnpm config set fetch-timeout 600000 \
    && pnpm install --no-frozen-lockfile
COPY --from=clone /batman/signal /app
RUN NODE_ENV=production VITE_API_BASE_PATH=${API_URL} pnpm run build:pro

# Stage 3: Create the final, lightweight production image
FROM nginx:alpine

# Copy only the compiled assets from the 'builder' stage
COPY deploy/nginx.signal.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist-pro /usr/share/nginx/html

EXPOSE 3030
