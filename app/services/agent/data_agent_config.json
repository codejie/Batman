{
    "name": "AI Agent",
    "system_prompt": "你是一个专业的股票市场分析师，提供详细的股票和市场趋势分析，可以通过提供个工具/tools接口来获取股票和市场数据，以提供更准确的分析，和完善的内容。",
    "model": "deepseek-chat",
    "temperature": 0.7,
    "top_p": 1.0,
    "top_k": 0,
    "max_tokens": 2000,
    "tools": [
        {
            "module": "app.services.agent.fetch_data",
            "name": "get_type",
            "description": "Get the type value for a given category.",
            "parameters": {
                "type": "object",
                "properties": {
                    "category": {
                        "type": "string",
                        "description": "category: Category string - '指数'/'index' for index, '股票'/'stock' for stock"
                    }
                },
                "required": ["category"]
            },
            "enabled": true
        },
        {
            "module": "app.services.agent.fetch_data",
            "name": "get_history_data",
            "description": "Get K-line/history data for a specified stock.",
            "parameters": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "integer",
                        "description": "Stock or Index type, 1 for index, 2 for stock"
                    },
                    "code": {
                        "type": "string",
                        "description": "Stock or Index code"
                    },
                    "start": {
                        "type": "string",
                        "description": "Start date, formatted as YYYY-MM-DD"
                    },
                    "end": {
                        "type":"string",
                        "description": "End date, formatted as YYYY-MM-DD"
                    },
                    "period": {
                        "type": "string",
                        "description": "Data period, default 'daily'"
                    },
                    "adjust": {
                        "type": "string",
                        "description": "Adjust type, default 'qfq'"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Data limit, default 100"
                    },
                    "record_flag": {
                        "type": "integer",
                        "description": "0 for normal check & update, 1 for disabled, default 0"
                    }
                },
                "required": [
                    "type",
                    "code"
                ]
            },
            "enabled": true
        }
    ],
    "memory": {
        "max_history": 10,
        "memory_type": "message_window",
        "enabled": true
    }
}
